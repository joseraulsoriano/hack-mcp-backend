DATABASE_URL=postgres://hack:hack@localhost:5433/hack

# Opcional. Si esta presente, el RAG genera embeddings con OpenAI.
# Si no, query_knowhow cae a busqueda por keyword (ILIKE + trigram).
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# MCP server
MCP_HTTP_PORT=3333

# Tenant por defecto para seed y smoke
DEFAULT_TENANT_SLUG=acme
